# Course server configuration (SECURITY_ARCHITECTURE.md §10). Copy to your shell environment; never commit values.
# There are no cryptographic secrets in v1 (opaque session tokens, salted password hashes).
SLS_MODE=            # demo (default) | test | institutional
SLS_DATA_DIR=        # default %LOCALAPPDATA%\SysMLStudio\data; refused inside the repository or a synced folder
SLS_HOST=            # default 127.0.0.1 (loopback only unless SLS_MODE=institutional)
SLS_PORT=            # default 5174
SLS_ORIGINS=         # extra allowed origins, comma-separated (the API port and the Vite dev server 5173 are built in)
SLS_COOKIE_SECURE=   # true behind HTTPS (forced in institutional mode)
SLS_DEPARTMENT_LABEL=