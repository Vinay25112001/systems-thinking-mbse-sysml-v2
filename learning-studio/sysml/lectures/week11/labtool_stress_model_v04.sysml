		requirement <'REQ-SYS-005'> 'Failure warning delivery' {
			doc /* The alarm gateway shall deliver each failure warning to the scheduling software over IF-006 within 2 min of detection. */
			subject failureWarningsToTheCoordinator : 'O\'Neil "Quick" Relief \\ Network */ Co Model'::Physical::'Failure warnings to the coordinator';
			@RequirementAttributes { level = "system"; requirementType = "interface"; method = VerificationMethodKind::test; criterion = "every warning received within 2 min in 20 injected failures"; }
			@Rationale { text = "A warning that arrives late cannot save the stock."; }
