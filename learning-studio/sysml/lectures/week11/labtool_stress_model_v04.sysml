	package Physical {
		doc /* The system of interest and the elements inside its boundary (Week 1). Components, ports and interfaces follow in Week 11. */
		part def 'System of interest' { doc /* The network's collection, warehousing and delivery service that moves donated food from donors to partner pantries. */ }
		part def 'soi';
		part def 'warehouse';
		part def 'Donation intake desk';
		part soi2 : 'System of interest' {
			part <'PRT-001'> soi3 : 'soi';
			part <'PRT-003'> warehouse2 : 'warehouse';
			part <'PRT-004'> donationIntakeDesk : 'Donation intake desk';
		}
		// --- generated by the Week 9 lab tool: begin ---
		part def 'Freezer' {
			doc /* Placeholder subject of REQ-SYS-003 (Week 9). Week 11 models this element; keep the name, or update the subjects when it is renamed. */
			attribute minTemperature : ThermodynamicTemperatureValue;
		}
		// --- generated by the Week 9 lab tool: end ---
		// --- generated by the Week 11 lab tool: begin ---
		// Week 11 models here what the package doc announces: the physical elements, their components, ports and interfaces. The part definitions above it are kept as written; the physical elements that stand for them specialize them.
		// The items added in Week 11: what crosses an interface that no item of the model names.
		item def 'action' { doc /* Material item added in Week 11. */ }
		// The physical elements (Week 4) as part definitions; a part definition of the same name is reused, a linked one is specialized, so the requirements whose subject it is still conform.
		part def 'Logical' { doc /* Battery sensors in each freezer and a cellular gateway. */ }
		part def 'Refrigerated vans' { doc /* Vans * / with "quotes" and \ backslashes. */ }
		part def 'Pantry refrigerators' { doc /* One refrigerator at each partner pantry (the Week 3 decision). */ }
		part def 'Scheduling and reporting software' { doc /* The coordinator's cloud scheduling tool with route planning. */ }
		part def 'Warehouse dock and workshop' { doc /* Loading dock, volunteers and the technician's workshop. */ }
		// The components (Week 5) as part definitions.
		part def 'state' { doc /* Collects sensor readings and places alarm calls. Kind: hardware. Week 5 functions: FN-006 (performed by PHY-001 in this model). */ }
		part def 'Freezer sensors' { doc /* Measure each freezer every minute. Kind: hardware. Week 5 functions: FN-005 (performed by PHY-001 in this model). */ }
		part def 'Route planner' { doc /* Plans routes within driver shifts. Kind: software. Week 5 functions: FN-001 (performed by PHY-004 in this model). */ }
		part def 'Reach reporting' { doc /* Builds the quarterly district report. Kind: software. Week 5 functions: FN-010 (performed by PHY-004 in this model). */ }
		// One port definition per interface (course convention): end A uses it, end B its conjugate, so every out item meets an in item.
		port def 'Pick list to the dock port' {
			doc /* The port of Scheduling and reporting software on IF-001; Warehouse dock and workshop uses its conjugate. */
			out item action_ : 'O\'Neil "Quick" Relief \\ Network */ Co Model'::Logical::'INFO-001';
		}
		port def 'Requirements port' {
			doc /* The port of Refrigerated vans on IF-002; Scheduling and reporting software uses its conjugate. */
			out item deliveryRecordsINFO003 : 'O\'Neil "Quick" Relief \\ Network */ Co Model'::Logical::'INFO-003';
		}
		port def 'Cargo log download port' {
			doc /* The port of Refrigerated vans on IF-004; Warehouse dock and workshop uses its conjugate. */
			out item vanCargoTemperatureLog : 'O\'Neil "Quick" Relief \\ Network */ Co Model'::Logical::'INFO-004';
		}
		port def 'Crates to the pantry port' {
			doc /* The port of Refrigerated vans on IF-005; Pantry refrigerators uses its conjugate. */
			in item loadedVan : 'O\'Neil "Quick" Relief \\ Network */ Co Model'::Logical::'Loaded van';
		}
		port def 'Failure warnings to the coordinator port' {
			doc /* The port of Freezer failure prediction on IF-006; Scheduling and reporting software uses its conjugate. */
		}
		// The interfaces (Week 5) as interface definitions: two port ends and a flow for each crossing.
		interface def 'Pick list to the dock' {
			doc /* Information interface IF-001. Medium: printed pick list. Constraint: pick list ready by 7:00 on delivery days. Degraded mode: Printer down: the coordinator reads the order list to the dock by phone. */
			end port schedulingAndReportingSoftware : 'Pick list to the dock port';
			end port warehouseDockAndWorkshop : ~'Pick list to the dock port';
			flow schedulingAndReportingSoftware.action_ to warehouseDockAndWorkshop.action_;
		}
		interface def 'Requirements' {
			doc /* Information interface IF-002. Medium: driver phone app over the cellular network. Protection: authenticate each driver phone; encrypt records in transit. Degraded mode: No signal: the app keeps the records and syncs them at the dock. */
			end port refrigeratedVans : 'Requirements port';
			end port schedulingAndReportingSoftware : ~'Requirements port';
			flow refrigeratedVans.deliveryRecordsINFO003 to schedulingAndReportingSoftware.deliveryRecordsINFO003;
		}
		interface def 'Cargo log download' {
			doc /* Information interface IF-004. Medium: logger cable at the dock. Degraded mode: Logger unreadable: the load is checked with a probe thermometer before it is kept. */
			end port refrigeratedVans : 'Cargo log download port';
			end port warehouseDockAndWorkshop : ~'Cargo log download port';
			flow refrigeratedVans.vanCargoTemperatureLog to warehouseDockAndWorkshop.vanCargoTemperatureLog;
		}
		interface def 'Crates to the pantry' {
			doc /* Physical interface IF-005. Medium: hand trolley at the pantry door. Constraint: crates into the refrigerator within 10 min of arrival. Degraded mode: Pantry closed: the driver returns the crates to the warehouse cold room. */
			end port refrigeratedVans : 'Crates to the pantry port';
			end port pantryRefrigerators : ~'Crates to the pantry port';
			flow pantryRefrigerators.loadedVan to refrigeratedVans.loadedVan;
		}
