	package Behavior {
		doc /* Mapped in Week 8, modeled later: Operational scenario SCN-001 to SCN-005 (Week 10: use case with actors). */
		// --- generated by the Week 10 lab tool: begin ---
		// The Week 2 scenarios as use cases: subject the enterprise, an actor for each modeled actor, the success end state as objective.
		use case <'SCN-001'> 'Passenger Ride Request' {
			doc /* A passenger requests a ride and receives a confirmed booking with an assigned aircraft and boarding time. Trigger: A passenger asks for a ride between two vertiports. Preconditions: The passenger has an account; the request is made within the 16 h operating day; at least one aircraft in the network is dispatch-ready. Failure end state: Request declined, with the reason recorded and an alternative offered. Actors not modeled as parts: Customer services agent. */
			subject enterprise : Context::'ENT-001';
			actor passengers : Stakeholders::'STK-001';
			objective { doc /* Success: Confirmed booking with an assigned aircraft and a boarding time. */ }
		}
		use case <'SCN-002'> 'Passenger Transport Mission' {
			doc /* A booked party is flown 25 km between two vertiports and the aircraft is handed to charging. Trigger: The boarding time of a confirmed booking (SCN-001) is reached. Preconditions: Booking confirmed; aircraft dispatch-ready (charged to the dispatch threshold, no open no-go fault); forecast weather within limits at both vertiports. Failure end state: Flight not flown, or landed at an alternate vertiport, with the party re-accommodated and no flight outside limits. */
			subject enterprise : Context::'ENT-001';
			actor passengers : Stakeholders::'STK-001';
			actor pilotsRemoteOperators : Stakeholders::'STK-008';
			actor controlledAirspaceAirTrafficService : Context::'Controlled airspace (air traffic service)';
			actor vertiportOperators : Stakeholders::'STK-005';
			objective { doc /* Success: Passengers delivered; flight data logged; the aircraft on the destination pad with at least 20 % usable energy remaining. */ }
			attribute destinationPadOccupied : Boolean;
			attribute passengerNoShow : Boolean;
			attribute intentNotAccepted : Boolean;
			first start;
			then action planFlight :> Logical::'FN-003' { doc /* 1. System: Plans the flight with at least 20 % usable energy at landing. */ }
			then action fileFlightIntent :> Logical::'FN-012' { doc /* 2. System: Files the flight intent with the air traffic service. */ }
			then decide beforeAcceptIntent;
				if intentNotAccepted then holdAndRefile;
				else acceptIntent;
			action holdAndRefile { doc /* A3 (before step 3): The air traffic service does not accept the flight intent. Hold the departure and re-file; if no acceptance is given, cancel and re-accommodate the party. The scenario ends. */ }
			then done;
			action acceptIntent { doc /* 3. Air traffic service: Accepts the flight intent. */ }
			then action boardParty :> Logical::'FN-014' { doc /* 4. Vertiport operator: Boards the party step-free at the departure pad. */ }
			then decide afterBoardParty;
				if passengerNoShow then departWithRemainingParty;
				else rejoinTakeOffAndCruise;
			action departWithRemainingParty { doc /* A2 (after step 4): A passenger does not show. Depart on time with the remaining party. Rejoins at step 5. */ }
			then rejoinTakeOffAndCruise;
			merge rejoinTakeOffAndCruise;
			then action takeOffAndCruise :> Logical::'FN-005' { doc /* 5. Pilot: Takes off within the pad-edge noise limit and cruises for about 10 min at 150 km/h. */ }
			then decide beforeApproachAndLand;
				if destinationPadOccupied then holdOrDivert;
				else approachAndLand;
			action holdOrDivert { doc /* A1 (before step 6): The destination pad is occupied. Hold, or divert to the nearest open vertiport within the energy reserve. Rejoins at step 7. */ }
			then rejoinDeplane;
			action approachAndLand :> Logical::'FN-005' { doc /* 6. Pilot: Approaches and lands at the destination pad. */ }
			then merge rejoinDeplane;
			then action deplane :> Logical::'FN-014' { doc /* 7. Passenger: Deplanes at the destination; the aircraft passes to charging (SCN-003). */ }
			then done;
			// Item flows: from the step whose function produces the item to a later step whose function consumes it.
			flow planFlight.flightReleaseAndPlan to fileFlightIntent.flightReleaseAndPlan;
			flow planFlight.flightReleaseAndPlan to takeOffAndCruise.flightReleaseAndPlan;
			flow boardParty.passengerPartyOut to takeOffAndCruise.passengerPartyIn;
			flow planFlight.flightReleaseAndPlan to approachAndLand.flightReleaseAndPlan;
			flow takeOffAndCruise.passengerPartyOut to approachAndLand.passengerPartyIn;
			flow boardParty.passengerInformationOut to deplane.passengerInformationIn;
			flow approachAndLand.passengerPartyOut to deplane.passengerPartyIn;
		}
		use case <'SCN-003'> 'Aircraft Charging' {
			doc /* An arrived aircraft is charged to the dispatch threshold in 20 min and is dispatch-ready within the 25 min hub turnaround. Trigger: An aircraft lands on a hub pad at the end of SCN-002. Preconditions: A turnaround charger is free; the vertiport power limit (TBD-02) is configured. Failure end state: Aircraft withdrawn from service, or released late, with the reason recorded. Actors not modeled as parts: Fleet controller. */
			subject enterprise : Context::'ENT-001';
			actor vertiportOperators : Stakeholders::'STK-005';
			actor electricGrid : Context::'Electric grid';
			objective { doc /* Success: Aircraft dispatch-ready within the 25 min hub turnaround. */ }
		}
		use case <'SCN-004'> 'Maintenance Event' {
			doc /* A fault is reported or predicted; the aircraft is withheld, repaired and returned to service. Trigger: Aircraft health monitoring reports a fault, or predictive maintenance flags one. Preconditions: The aircraft is in service; maintenance records and the approved deferral rules are available. Failure end state: Aircraft out of service with an expected return date, or in service under a recorded deferral. Actors not modeled as parts: Fleet controller. */
			subject enterprise : Context::'ENT-001';
			actor maintenanceTechnicians : Stakeholders::'STK-009';
			actor aircraftAndSparesSupply : Context::'Aircraft and spares supply';
			objective { doc /* Success: Aircraft returned to service with complete records. */ }
		}
		use case <'SCN-005'> 'Weather Disruption' {
			doc /* Forecast weather approaches the aircraft limits at a vertiport; flights are held or diverted and the backlog is recovered. Trigger: The forecast for a vertiport crosses a weather limit within the next 30 min (limits TBD-01, U-001). Preconditions: Flights are scheduled and some are airborne; weather data are received for all six vertiports; alternates and the 20 % energy reserve policy are in force. Failure end state: Service at V3 suspended for the day with every affected passenger re-accommodated or refunded and no flight outside limits. Actors not modeled as parts: Operations-center duty manager (primary). */
			subject enterprise : Context::'ENT-001';
			actor passengers : Stakeholders::'STK-001';
			actor pilotsRemoteOperators : Stakeholders::'STK-008';
			actor controlledAirspaceAirTrafficService : Context::'Controlled airspace (air traffic service)';
			actor weather : Context::'Weather';
			objective { doc /* Success: All aircraft on the ground or safely diverted; no flight dispatched outside limits; the backlog flown within the day. */ }
		}
		// The signals that trigger the transitions.
		attribute def ChargerConnected;
		attribute def DispatchThresholdReached;
		attribute def DispatchRelease;
		attribute def LandedOnPad;
		attribute def CellOverTemperature;
		attribute def NoGoFaultReported;
		attribute def ReturnedToService;
		state def AircraftOperatingStates {
			doc /* Operating states of one aircraft over a turnaround cycle (SCN-002, SCN-003, SCN-004) */
			attribute noGoFaultOpen : Boolean;
			first start then onPad;
			state onPad { doc /* On a vertiport pad after landing; passengers deplane and board. */ }
			state charging { doc /* Connected to a turnaround charger. */ do Logical::'FN-006'; }
			state dispatchReady { doc /* Charged to the dispatch threshold. */ }
			state inFlight { do Logical::'FN-005'; }
			state outOfService { doc /* Withheld from dispatch. */ entry Logical::'FN-008'; }
			transition onPadToCharging first onPad accept ChargerConnected then charging;
			transition chargingToDispatchReady first charging accept DispatchThresholdReached then dispatchReady;
			transition dispatchReadyToInFlight first dispatchReady accept DispatchRelease if not noGoFaultOpen then inFlight;
			transition inFlightToOnPad first inFlight accept LandedOnPad then onPad;
			transition chargingToOutOfService first charging accept CellOverTemperature then outOfService;
			transition dispatchReadyToOutOfService first dispatchReady accept NoGoFaultReported then outOfService;
			transition onPadToOutOfService first onPad accept NoGoFaultReported then outOfService;
			transition outOfServiceToOnPad first outOfService accept ReturnedToService then onPad;
		}
		state aircraftOperatingStates : AircraftOperatingStates;
		// --- generated by the Week 10 lab tool: end ---
	}
	package Logical {
		doc /* Week 10 models the functions and logical elements here. */
		// --- generated by the Week 9 lab tool: begin ---
		part def 'Flight Operations' {
			doc /* Placeholder subject of REQ-SYS-003 (Week 9). Week 10 models this element; keep the name, or update the subjects when it is renamed. */
			attribute plannedLandingEnergyPercent : Real;
		}
		part def 'Scheduling' {
			doc /* Placeholder subject of REQ-SYS-005, REQ-SYS-011 (Week 9). Week 10 models this element; keep the name, or update the subjects when it is renamed. */
			attribute assignmentLatencyP99 : DurationValue;
			attribute movementsScheduledBeyondLimit : Natural;
		}
		part def 'Fleet Management' {
			doc /* Placeholder subject of REQ-SYS-006 (Week 9). Week 10 models this element; keep the name, or update the subjects when it is renamed. */
			attribute fleetAvailabilityPercent : Real;
		}
		part def 'Maintenance Management' {
			doc /* Placeholder subject of REQ-SYS-008 (Week 9). Week 10 models this element; keep the name, or update the subjects when it is renamed. */
			attribute noGoFlagLatency : DurationValue;
		}
		part def 'Customer Services' {
			doc /* Placeholder subject of REQ-SYS-012 (Week 9). Week 10 models this element; keep the name, or update the subjects when it is renamed. */
			attribute confirmationsAcceptedBeforeFareShown : Natural;
		}
		// --- generated by the Week 9 lab tool: end ---
		// --- generated by the Week 10 lab tool: begin ---
		// The capabilities (Week 2) as action definitions (course convention).
		action def <'CAP-001'> 'On-demand passenger transport' { doc /* Carry a booked party of 1-4 passengers between any two vertiports of the network on demand. */ }
		action def <'CAP-002'> 'Ride booking and dispatch' { doc /* Accept a ride request, match it to a dispatch-ready aircraft and release the flight. */ }
		action def <'CAP-003'> 'Fleet charging management' { doc /* Return arriving aircraft to a dispatch-ready energy state within the turnaround time at hub vertiports. */ }
		action def <'CAP-004'> 'Flight operations within safety limits' { doc /* Plan, coordinate and fly each flight within approved airworthiness, energy-reserve and airspace limits. */ }
		action def <'CAP-005'> 'Weather-aware operations' { doc /* Detect weather approaching limits and hold, divert or recover flights accordingly. */ }
		action def <'CAP-006'> 'Fleet health management' { doc /* Know the condition of each aircraft and its battery, and withhold unfit aircraft from dispatch. */ }
		action def <'CAP-007'> 'Noise-managed vertiport operations' { doc /* Operate take-offs and landings so that noise at nearby homes stays within both agreed limits: the level of each event and the number of events in the noise-sensitive hours. */ }
		action def <'CAP-008'> 'Capacity planning' { doc /* Forecast demand and plan fleet and charging capacity to meet it. */ }
		action def <'CAP-009'> 'Incident response support' { doc /* Detect vertiport incidents and give emergency responders warning and safe access. */ }
		action def <'CAP-010'> 'Charging power control' { doc /* Schedule and limit charging power so that each vertiport stays within its grid connection. */ }
		action def <'CAP-011'> 'Site compliance' { doc /* Select and keep vertiport sites that conform to the land-use plan and connect with public transport. */ }
		action def <'CAP-012'> 'Workload-managed operations' { doc /* Assign and support flights so that each operator's workload stays within agreed limits, including in disruptions. */ }
		action def <'CAP-013'> 'Operational risk evidence' { doc /* Record flight, incident and maintenance evidence from which operational risk can be measured. */ }
		action def <'CAP-014'> 'Fare transparency and competitiveness' { doc /* Price trips competitively with ground alternatives and show the full fare before a booking is confirmed. */ }
		action def <'CAP-015'> 'Disruption notice and re-accommodation' { doc /* Tell passengers promptly when a confirmed trip is held, diverted or cancelled, and re-accommodate them on a usable way onward. */ }
		// The items the functions consume and produce: the Week 4 information items and the items added in Week 10.
		item def <'INFO-001'> 'Passenger information' { doc /* Ride requests, party size, accessibility needs, confirmation and boarding timestamps. */ }
		item def <'INFO-002'> 'Flight data' { doc /* Flight plan, position, energy state, landing energy, and health and fault reports for each flight. */ }
		item def <'INFO-003'> 'Maintenance data' { doc /* Fault reports, deferrals, work orders, release-to-service records and battery charge-session data. */ }
		item def <'INFO-004'> 'Weather data' { doc /* Observed and forecast wind, gust and visibility at each vertiport. */ }
		item def <'INFO-005'> 'Financial data' { doc /* Fare revenue, operating cost and capital spend by vertiport and aircraft. */ }
		item def <'INFO-006'> 'Operational evidence' { doc /* For every flight: the flight data, any incident, and the maintenance actions, kept as an auditable log. */ }
		item def <'INFO-007'> 'Service status and disruption decisions' { doc /* Weather holds, diversions, cancellations and remaining capacity per vertiport, as decided at the operations center. */ }
		item def <'INFO-008'> 'Flight release and plan' { doc /* For each flight: the release, the route and energy plan with the landing reserve, and the accepted flight intent. */ }
		item def <'INFO-009'> 'Flight intent' { doc /* The route and timing of each flight filed with the air traffic service, and its acceptance or amendment. */ }
		item def <'INFO-010'> 'Pad fire alarm' { doc /* An automatic alarm with the pad location when a battery fire is detected on a pad. */ }
		item def <'INFO-011'> 'Charging power set-points' { doc /* Information item added in Week 10. */ }
		item def <'INFO-012'> 'Aircraft assignment' { doc /* Information item added in Week 10. */ }
		item def <'INFO-013'> 'Disruption notice' { doc /* Information item added in Week 10. */ }
		item def <'INFO-014'> 'Operator assignment' { doc /* Information item added in Week 10. */ }
		item def <'INFO-015'> 'Demand forecast' { doc /* Information item added in Week 10. */ }
		item def <'INFO-016'> 'Aircraft availability' { doc /* Information item added in Week 10. */ }
		item def 'Electrical energy' { doc /* Energy item added in Week 10. */ }
		item def 'Passenger party' { doc /* Material item added in Week 10. */ }
		item def 'Heat and flame' { doc /* Energy item added in Week 10. */ }
		// The functions (Week 4) as action usages, each with an in parameter for every item it consumes and an out parameter for every item it produces.
		action <'FN-001'> 'Accept ride request' {
			doc /* Receive origin, destination and party size; quote the full fare and a boarding-time estimate; confirm the booking. */
			in serviceStatusAndDisruptionDecisions : 'INFO-007';
			out passengerInformation : 'INFO-001';
		}
		action <'FN-002'> 'Match request to aircraft' {
			doc /* Select a dispatch-ready aircraft and a time slot for a confirmed request, within each pad's sensitive-hour movement limit. */
			in passengerInformation : 'INFO-001';
			in maintenanceData : 'INFO-003';
			in aircraftAvailability : 'INFO-016';
			out aircraftAssignment : 'INFO-012';
		}
		action <'FN-003'> 'Plan flight' {
			doc /* Produce a route and energy plan that lands with at least the 20 % reserve. */
			in aircraftAssignment : 'INFO-012';
			in flightData : 'INFO-002';
			in weatherData : 'INFO-004';
			out flightReleaseAndPlan : 'INFO-008';
		}
		action <'FN-004'> 'Assess dispatch weather' {
			doc /* Compare vertiport forecasts with the weather limits and place or lift dispatch holds. */
			in weatherData : 'INFO-004';
			out serviceStatusAndDisruptionDecisions : 'INFO-007';
		}
		action <'FN-005'> 'Fly passenger trip' {
			doc /* Take off, cruise, approach and land on the published procedures. */
			in flightReleaseAndPlan : 'INFO-008';
			in passengerPartyIn : 'Passenger party';
			in electricalEnergy : 'Electrical energy';
			out flightData : 'INFO-002';
			out passengerPartyOut : 'Passenger party';
		}
		action <'FN-006'> 'Charge aircraft' {
			doc /* Restore battery energy to the dispatch threshold during the turnaround. */
			in electricalEnergy : 'Electrical energy';
			in chargingPowerSetPoints : 'INFO-011';
			out maintenanceData : 'INFO-003';
		}
		action <'FN-007'> 'Control vertiport charging power' {
			doc /* Share the vertiport connection limit among the active charging sessions. */
			in maintenanceData : 'INFO-003';
			out chargingPowerSetPoints : 'INFO-011';
		}
		action <'FN-008'> 'Assess aircraft health' {
			doc /* Classify reported and predicted faults as go or no-go and set each aircraft's availability. */
			in flightData : 'INFO-002';
			out maintenanceData : 'INFO-003';
		}
		action <'FN-009'> 'Manage fleet availability' {
			doc /* Plan maintenance slots and spare aircraft so that the scheduled aircraft-hours are met. */
			in maintenanceData : 'INFO-003';
			in aircraftAssignment : 'INFO-012';
			out aircraftAvailability : 'INFO-016';
		}
		action <'FN-010'> 'Detect and report pad fire' {
			doc /* Detect a battery fire on a pad and alert the emergency services. */
			in heatAndFlame : 'Heat and flame';
			out padFireAlarm : 'INFO-010';
			out operationalEvidence : 'INFO-006';
		}
		action <'FN-011'> 'Dispatch aircraft' {
			doc /* Release an assigned aircraft for flight after the go / no-go interlock and the weather-hold check. */
			in aircraftAssignment : 'INFO-012';
			in maintenanceData : 'INFO-003';
			in flightReleaseAndPlanIn : 'INFO-008';
			out flightReleaseAndPlanOut : 'INFO-008';
		}
		action <'FN-012'> 'Coordinate flight intent' {
			doc /* Exchange route and timing with the air traffic service before departure. */
			in flightReleaseAndPlan : 'INFO-008';
			in flightIntentIn : 'INFO-009';
			out flightIntentOut : 'INFO-009';
		}
		action <'FN-013'> 'Forecast demand' {
			doc /* Forecast trips per vertiport pair and hour for scheduling and capacity planning. */
			in passengerInformation : 'INFO-001';
			in weatherData : 'INFO-004';
			out demandForecast : 'INFO-015';
		}
		action <'FN-014'> 'Board and alight passengers' {
			doc /* Move passengers, wheelchair users included, between the terminal and the cabin. */
			in passengerInformationIn : 'INFO-001';
			in passengerPartyIn : 'Passenger party';
			out passengerInformationOut : 'INFO-001';
			out passengerPartyOut : 'Passenger party';
		}
		action <'FN-015'> 'Notify disrupted passengers' {
			doc /* Tell each passenger whose confirmed trip is held, diverted or cancelled, and offer a new time, an alternate vertiport, a way onward or a refund. */
			in serviceStatusAndDisruptionDecisions : 'INFO-007';
			out disruptionNotice : 'INFO-013';
		}
		action <'FN-016'> 'Record operational evidence' {
			doc /* Keep an auditable record of the flight data, incidents and maintenance actions of every flight. */
			in operationalEvidenceIn : 'INFO-006';
			out operationalEvidenceOut : 'INFO-006';
		}
		action <'FN-017'> 'Assign flights to operators' {
			doc /* Give each remote operator no more simultaneous flights than the workload limit, diversions included. */
			in aircraftAssignment : 'INFO-012';
			out operatorAssignment : 'INFO-014';
		}
		// Course convention: a function or requirement depends on the capability it was derived from (client after from, supplier after to).
		#derivedFrom dependency 'FN-001 derived from CAP-002' from 'FN-001' to 'CAP-002';
