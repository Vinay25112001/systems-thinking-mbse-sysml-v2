		// Logical elements (Week 4) as part definitions; a Week 9 placeholder linked to one is specialized, so its requirement subjects still conform.
		part def 'Decision Support' { doc /* Provides weather assessment and demand forecasts to operational and planning decisions. */ }
		part def 'Vertiport Operations' { doc /* Runs passenger flow and pad safety at the vertiports, fire detection included. */ }
		part logicalArchitecture {
			doc /* The logical architecture (Week 4): one part per logical element, each the performer of the functions allocated to it. */
			part <'LOG-001'> flightOperations : 'Flight Operations' {
				perform Logical::'FN-003';
				perform Logical::'FN-005';
				perform Logical::'FN-012';
			}
			part <'LOG-002'> fleetManagement : 'Fleet Management' {
				perform Logical::'FN-006';
				perform Logical::'FN-007';
				perform Logical::'FN-009';
				perform Logical::'FN-016';
			}
			part <'LOG-003'> maintenanceManagement : 'Maintenance Management' {
				perform Logical::'FN-008';
			}
			part <'LOG-004'> customerServices : 'Customer Services' {
				perform Logical::'FN-001';
				perform Logical::'FN-015';
			}
			part <'LOG-005'> scheduling : 'Scheduling' {
				perform Logical::'FN-002';
				perform Logical::'FN-011';
				perform Logical::'FN-017';
			}
			part <'LOG-006'> decisionSupport : 'Decision Support' {
				perform Logical::'FN-004';
				perform Logical::'FN-013';
			}
			part <'LOG-007'> vertiportOperations : 'Vertiport Operations' {
				perform Logical::'FN-010';
				perform Logical::'FN-014';
			}
		}
		// Requirements allocated to functions (Week 4): the function is responsible for realizing the intent of the requirement.
		allocate Requirements::'REQ-SYS-012' to 'FN-001';
		allocate Requirements::'REQ-STK-001' to 'FN-001';
		allocate Requirements::'REQ-SYS-005' to 'FN-002';
