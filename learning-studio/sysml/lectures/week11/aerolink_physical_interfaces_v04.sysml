	package Physical {
		doc /* The system of interest and the elements inside its boundary (Week 1). Components, ports and interfaces follow in Week 11. */
		part def 'System of interest' { doc /* the AeroLink air-taxi service: The system of interest inside the enterprise. AeroLink controls the fleet, the operations center, and booking and dispatch: the narrower system of interest. The service also needs elements AeroLink does not control, the vertiport operators' pads and chargers and the passenger demand they serve, so SOI-001 is drawn at the wider system of interest, which SEBoK permits for a service. */ }
		part soi : 'System of interest';
		// --- generated by the Week 9 lab tool: begin ---
		part def 'Chargers' {
			doc /* Placeholder subject of REQ-SYS-001, REQ-SYS-010 (Week 9). Week 11 models this element; keep the name, or update the subjects when it is renamed. */
			attribute chargeTimeToDispatch : DurationValue;
			attribute combinedChargerPower : PowerValue;
		}
		part def 'Aircraft' {
			doc /* Placeholder subject of REQ-SYS-002, REQ-SYS-007 (Week 9). Week 11 models this element; keep the name, or update the subjects when it is renamed. */
			attribute padEdgeNoise : SoundPressureLevelValue;
			attribute stillAirDesignTripBlockTime : DurationValue;
			// --- generated by the Week 10 lab tool: begin ---
			exhibit Behavior::aircraftOperatingStates;
			// --- generated by the Week 10 lab tool: end ---
		}
		part def 'Ops center' {
			doc /* Placeholder subject of REQ-SYS-004, REQ-SYS-013, REQ-SYS-014 (Week 9). Week 11 models this element; keep the name, or update the subjects when it is renamed. */
			attribute missedWeatherHolds : Natural;
			attribute intentLeadTime : DurationValue;
			attribute forecastRefreshInterval : DurationValue;
		}
		part def 'Fire alarm' {
			doc /* Placeholder subject of REQ-SYS-009, REQ-SYS-015 (Week 9). Week 11 models this element; keep the name, or update the subjects when it is renamed. */
			attribute alarmTransmissionTime : DurationValue;
			attribute incidentRecordDelay : DurationValue;
		}
		// --- generated by the Week 9 lab tool: end ---
		// --- generated by the Week 11 lab tool: begin ---
		// Week 11 models here what the package doc announces: the physical elements, their components, ports and interfaces. The part definitions above it are kept as written; the physical elements that stand for them specialize them.
		// The items added in Week 11: what crosses an interface that no item of the model names.
		item def <'INFO-017'> 'Battery state and cell limits' { doc /* Information item added in Week 11. */ }
		item def <'INFO-018'> 'Charger readiness and session control' { doc /* Information item added in Week 11. */ }
		item def 'Landing and tie-down loads' { doc /* Mechanical load item added in Week 11. */ }
		// The physical elements (Week 4) as part definitions; a part definition of the same name is reused, a linked one is specialized, so the requirements whose subject it is still conform.
		part def 'eVTOL Aircraft' :> 'Aircraft' { doc /* Four-seat electric vertical take-off and landing aircraft. */ }
		part def 'Vertiports' { doc /* Sites with pads, terminals and step-free routes. */ }
		part def 'Charging Systems' :> 'Chargers' { doc /* Chargers at the vertiports with their power control: high-power turnaround chargers at hubs, standard chargers at spokes. */ }
		part def 'Operations Center' :> 'Ops center' { doc /* Hosts scheduling, dispatch, flight following, decision support and the evidence log, with a hot standby. */ }
		part def 'Maintenance Facility' { doc /* Battery workshop, diagnostic tools and certifying technicians. */ }
		part def 'Communications Infrastructure' { doc /* Air-ground datalink and ground network: the medium of the information interfaces, with no function of its own. */ }
		part def 'Passenger booking platform' { doc /* Mobile app and booking back end for requests, fares, boarding passes and notices. */ }
		part def 'Pad fire detection and alarm system' :> 'Fire alarm' { doc /* Thermal and flame detection at every pad with automatic alarm transmission. */ }
		// The components (Week 5) as part definitions.
		part def 'Airframe and rotors' { doc /* Turns battery energy into lift and thrust within the noise limit. Kind: hardware. Week 5 functions: FN-005 (performed by PHY-001 in this model). */ }
		part def 'Battery pack and battery management' { doc /* Stores energy and controls each charge through the charging handshake. Kind: hardware. Week 5 functions: FN-005 (performed by PHY-001 in this model). */ }
		part def 'Flight management and health monitoring' { doc /* Flies the accepted plan and reports flight data, health and faults. Kind: software. Week 5 functions: FN-005 (performed by PHY-001 in this model). */ }
		part def 'Pads' { doc /* Take-off and landing surfaces with tie-down points and markings. Kind: facility. Week 5 functions: FN-014 (performed by PHY-002 in this model). */ }
		part def 'Terminal and step-free route' { doc /* Moves passengers, wheelchair users included, between terminal and cabin. Kind: facility. Week 5 functions: FN-014 (performed by PHY-002 in this model). */ }
		part def 'Vertiport staff' { doc /* Board each party and handle aircraft on the pads. Kind: people. Week 5 functions: FN-014 (performed by PHY-002 in this model). */ }
		part def 'High-power turnaround chargers' { doc /* Charge aircraft to the dispatch threshold within the turnaround at hubs. Kind: hardware. Week 5 functions: FN-006 (performed by PHY-003 in this model). */ }
		part def 'Standard chargers' { doc /* Charge aircraft at the spoke vertiports where turnaround is not time-critical. Kind: hardware. Week 5 functions: FN-006 (performed by PHY-003 in this model). */ }
		part def 'Vertiport power controller' { doc /* Shares the vertiport connection limit among the active charging sessions. Kind: software. Week 5 functions: FN-007 (performed by PHY-003 in this model). */ }
		part def 'Scheduling and dispatch platform' { doc /* Matches requests, plans flights, coordinates intent and releases each flight. Kind: software. Week 5 functions: FN-002, FN-003, FN-011, FN-012, FN-017 (performed by PHY-004 in this model). */ }
		part def 'Hot-standby platform' { doc /* Takes over scheduling and dispatch within the assignment window if the platform fails. Kind: software. Week 5 functions: FN-002, FN-011 (performed by PHY-004 in this model). */ }
		part def 'Duty managers and remote operators' { doc /* Declare and lift weather holds and supervise every flight. Kind: people. Week 5 functions: FN-004, FN-017 (performed by PHY-004 in this model). */ }
		part def 'Planning and evidence services' { doc /* Forecast demand, plan fleet availability and keep the auditable evidence log. Kind: software. Week 5 functions: FN-009, FN-013, FN-016 (performed by PHY-004 in this model). */ }
		part def 'Certifying technicians' { doc /* Classify every fault and sign each return to service. Kind: people. Week 5 functions: FN-008 (performed by PHY-005 in this model). */ }
		part def 'Diagnostic tools and battery workshop' { doc /* Read fault reports, test packs and host the predictive-maintenance model. Kind: mixed. Week 5 functions: FN-008 (performed by PHY-005 in this model). */ }
		// One port definition per interface (course convention): end A uses it, end B its conjugate, so every out item meets an in item.
		port def 'Aircraft to pad port' {
			doc /* The port of eVTOL Aircraft on IF-001; Vertiports uses its conjugate. */
			out item landingAndTieDownLoads : 'Landing and tie-down loads';
			in item passengerPartyIn : Logical::'Passenger party';
			out item passengerPartyOut : Logical::'Passenger party';
		}
		port def 'Aircraft to operations center datalink port' {
			doc /* The port of eVTOL Aircraft on IF-002; Operations Center uses its conjugate. */
			out item flightData : Logical::'INFO-002';
			out item operationalEvidence : Logical::'INFO-006';
			in item flightReleaseAndPlan : Logical::'INFO-008';
		}
		port def 'Operations center to air traffic service port' {
			doc /* The port of Operations Center on IF-003; Controlled airspace (air traffic service) uses its conjugate. */
			out item flightIntentOut : Logical::'INFO-009';
			in item flightIntentIn : Logical::'INFO-009';
		}
		port def 'Aircraft to charger power and handshake port' {
			doc /* The port of eVTOL Aircraft on IF-005; Charging Systems uses its conjugate. */
			in item electricalEnergy : Logical::'Electrical energy';
			out item batteryStateAndCellLimits : 'Battery state and cell limits';
			in item chargerReadinessAndSessionControl : 'Charger readiness and session control';
		}
		port def 'Charger to electric grid port' {
			doc /* The port of Charging Systems on IF-006; Electric grid uses its conjugate. */
			in item electricalEnergy : Logical::'Electrical energy';
		}
		port def 'Fire alarm to emergency response service port' {
			doc /* The port of Pad fire detection and alarm system on IF-007; Emergency response service uses its conjugate. */
			out item padFireAlarm : Logical::'INFO-010';
		}
		port def 'Booking platform to operations center port' {
			doc /* The port of Passenger booking platform on IF-008; Operations Center uses its conjugate. */
			out item passengerInformation : Logical::'INFO-001';
			out item financialData : Logical::'INFO-005';
			in item serviceStatusAndDisruptionDecisions : Logical::'INFO-007';
		}
		port def 'Charger to operations center data port' {
			doc /* The port of Charging Systems on IF-010; Operations Center uses its conjugate. */
			out item maintenanceData : Logical::'INFO-003';
		}
		port def 'Weather information service to operations center port' {
			doc /* The port of Weather information service on IF-011; Operations Center uses its conjugate. */
			out item weatherData : Logical::'INFO-004';
		}
		port def 'Maintenance to operations center data port' {
			doc /* The port of Maintenance Facility on IF-012; Operations Center uses its conjugate. */
			out item maintenanceDataOut : Logical::'INFO-003';
			in item maintenanceDataIn : Logical::'INFO-003';
			out item operationalEvidence : Logical::'INFO-006';
		}
		port def 'Aircraft to maintenance health data link port' {
			doc /* The port of eVTOL Aircraft on IF-013; Maintenance Facility uses its conjugate. */
			out item flightData : Logical::'INFO-002';
		}
		port def 'Vertiport to operations center data port' {
			doc /* The port of Vertiports on IF-014; Operations Center uses its conjugate. */
			out item passengerInformation : Logical::'INFO-001';
		}
		port def 'Fire detection to operations center incident records port' {
			doc /* The port of Pad fire detection and alarm system on IF-015; Operations Center uses its conjugate. */
			out item operationalEvidence : Logical::'INFO-006';
		}
		// The interfaces (Week 5) as interface definitions: two port ends and a flow for each crossing.
		interface def 'Aircraft to pad' {
			doc /* Physical interface IF-001. Medium: pad surface, tie-down points and markings. Constraint: none recorded yet: the pad load rating is a design value for the vertiport operators. Degraded mode: A pad out of service is removed from scheduling; arriving aircraft divert to another pad or vertiport. */
			end port eVTOLAircraft : 'Aircraft to pad port';
			end port vertiports : ~'Aircraft to pad port';
			flow eVTOLAircraft.landingAndTieDownLoads to vertiports.landingAndTieDownLoads;
			flow vertiports.passengerPartyIn to eVTOLAircraft.passengerPartyIn;
			flow eVTOLAircraft.passengerPartyOut to vertiports.passengerPartyOut;
		}
		interface def 'Aircraft to operations center datalink' {
			doc /* Information interface IF-002. Medium: air-ground radio datalink (PHY-006). Constraint: the release and plan reach the aircraft before each departure; flight data flow continuously in flight. Protection: authenticate the sender of every release and plan; integrity-check every release (a forged release is a flight hazard). Degraded mode: Link lost in flight: the aircraft flies its accepted plan and lands with the reserve; the center marks flight following lost and sends no new release until the link returns. */
			end port eVTOLAircraft : 'Aircraft to operations center datalink port';
			end port operationsCenter : ~'Aircraft to operations center datalink port';
			flow eVTOLAircraft.flightData to operationsCenter.flightData;
			flow eVTOLAircraft.operationalEvidence to operationsCenter.operationalEvidence;
			flow operationsCenter.flightReleaseAndPlan to eVTOLAircraft.flightReleaseAndPlan;
		}
		interface def 'Operations center to air traffic service' {
			doc /* Information interface IF-003. Medium: the air traffic service's flight-intent data service. Constraint: each intent filed at least 10 min before the planned departure, and the acceptance received before release. Protection: authenticate both ends; integrity-check every intent and acceptance (the flight-intent data of R-009). Degraded mode: No accepted intent, no release: flights wait, and the duty manager coordinates urgent departures by voice under a manual procedure. Standard: the air traffic service's published message format. */
			end port operationsCenter : 'Operations center to air traffic service port';
			end port controlledAirspaceAirTrafficService : ~'Operations center to air traffic service port';
			flow operationsCenter.flightIntentOut to controlledAirspaceAirTrafficService.flightIntentOut;
			flow controlledAirspaceAirTrafficService.flightIntentIn to operationsCenter.flightIntentIn;
		}
		interface def 'Aircraft to charger power and handshake' {
			doc /* Physical interface IF-005. Medium: charging connector and cable. Constraint: charge from the 20 % reserve to the dispatch threshold within 20 min. Protection: the charger accepts only signed configurations (R-010); a local cell-temperature interlock stops charging without any network command. Degraded mode: Handshake lost: charging stops (fail safe); the aircraft moves to another charger and the turnaround grows. Standard: a published charging-connector standard (to be selected; it is what lets a future charger plug in). */
			end port eVTOLAircraft : 'Aircraft to charger power and handshake port';
			end port chargingSystems : ~'Aircraft to charger power and handshake port';
			flow chargingSystems.electricalEnergy to eVTOLAircraft.electricalEnergy;
			flow eVTOLAircraft.batteryStateAndCellLimits to chargingSystems.batteryStateAndCellLimits;
			flow chargingSystems.chargerReadinessAndSessionControl to eVTOLAircraft.chargerReadinessAndSessionControl;
		}
		interface def 'Charger to electric grid' {
			doc /* Physical interface IF-006. Medium: the grid connection at each vertiport (agreement AG-3). Constraint: combined charging power within the connection limit (TBD-02 kW). Degraded mode: Supply lost: charging stops at that vertiport; the regional-outage contingency applies (finish trips, public-transport fallback, staggered recharge). */
			end port chargingSystems : 'Charger to electric grid port';
			end port electricGrid : ~'Charger to electric grid port';
			flow electricGrid.electricalEnergy to chargingSystems.electricalEnergy;
		}
		interface def 'Fire alarm to emergency response service' {
			doc /* Information interface IF-007. Medium: alarm transmission to the emergency services dispatch center over two independent paths (proposed). Constraint: alarm received at the dispatch center within 30 s of detection. Protection: authenticate the alarm source so that false alarms cannot be injected; two diverse paths, so one failure or attack does not silence the alarm. Degraded mode: One path lost: the other carries the alarm. Both lost: the local alarm sounds and vertiport staff call the emergency number. Standard: the emergency services' alarm-receiving format. */
			end port padFireDetectionAndAlarmSystem : 'Fire alarm to emergency response service port';
			end port emergencyResponseService : ~'Fire alarm to emergency response service port';
			flow padFireDetectionAndAlarmSystem.padFireAlarm to emergencyResponseService.padFireAlarm;
		}
		interface def 'Booking platform to operations center' {
			doc /* Information interface IF-008. Medium: ground network (PHY-006). Constraint: confirmed requests reach scheduling so that an aircraft is assigned within 60 s; disruption decisions reach the booking platform within the notice time (TBD-05). Protection: domain separation: the booking front end has no direct path to the dispatch segment (DEC-002 condition, R-009); authenticate and integrity-check every assignment message; encrypt the personal data of passengers in transit. Degraded mode: Booking platform down: no new bookings, confirmed trips still fly. Operations center down: failover to the hot standby, then manual dispatch. */
			end port passengerBookingPlatform : 'Booking platform to operations center port';
			end port operationsCenter : ~'Booking platform to operations center port';
			flow passengerBookingPlatform.passengerInformation to operationsCenter.passengerInformation;
			flow passengerBookingPlatform.financialData to operationsCenter.financialData;
			flow operationsCenter.serviceStatusAndDisruptionDecisions to passengerBookingPlatform.serviceStatusAndDisruptionDecisions;
		}
		interface def 'Charger to operations center data' {
			doc /* Information interface IF-010. Medium: ground network (PHY-006). Constraint: charge-complete status reaches dispatch before the release of each charged aircraft. Protection: authenticate every charger; integrity-check charge-complete status (a false "complete" would release an aircraft that is not charged). Degraded mode: Status missing: dispatch treats the aircraft as not charged (fail safe) until the vertiport operator confirms on the pad. */
			end port chargingSystems : 'Charger to operations center data port';
			end port operationsCenter : ~'Charger to operations center data port';
			flow chargingSystems.maintenanceData to operationsCenter.maintenanceData;
		}
		interface def 'Weather information service to operations center' {
			doc /* Information interface IF-011. Medium: the provider's data feed over the public internet. Constraint: a forecast for every vertiport at least every 10 min, each covering at least the next 60 min. Protection: authenticate the provider; reject malformed or out-of-date forecasts (boundary enforcement). Degraded mode: The newest valid forecast no longer covers the next 30 min (it is more than 30 min old): dispatch holds the affected vertiports (fail safe) until a valid forecast arrives. Standard: the provider's published forecast format. */
			end port weatherInformationService : 'Weather information service to operations center port';
			end port operationsCenter : ~'Weather information service to operations center port';
			flow weatherInformationService.weatherData to operationsCenter.weatherData;
		}
		interface def 'Maintenance to operations center data' {
			doc /* Information interface IF-012. Medium: ground network (PHY-006). Constraint: go / no-go status at dispatch within its share of the 2 min budget (see the latency budget). Protection: least privilege: only the maintenance facility may write go / no-go status; integrity-check every status message. Degraded mode: Status missing or stale: dispatch treats the aircraft as no-go (fail safe) until maintenance confirms. */
			end port maintenanceFacility : 'Maintenance to operations center data port';
			end port operationsCenter : ~'Maintenance to operations center data port';
			flow maintenanceFacility.maintenanceDataOut to operationsCenter.maintenanceDataOut;
			flow operationsCenter.maintenanceDataIn to maintenanceFacility.maintenanceDataIn;
			flow maintenanceFacility.operationalEvidence to operationsCenter.operationalEvidence;
		}
		interface def 'Aircraft to maintenance health data link' {
			doc /* Information interface IF-013. Medium: air-ground radio datalink (PHY-006). Constraint: fault reports reach maintenance within their share of the 2 min budget. Protection: authenticate the aircraft as the sender of every health and fault report (anyone with a transmitter can reach the radio link); integrity-check every health and fault report. Degraded mode: Link lost: fault reports are downloaded on arrival, so the 2 min of REQ-SYS-008 cannot hold during the loss; the aircraft is not released again until a fresh report is classified (fail safe). */
			end port eVTOLAircraft : 'Aircraft to maintenance health data link port';
			end port maintenanceFacility : ~'Aircraft to maintenance health data link port';
			flow eVTOLAircraft.flightData to maintenanceFacility.flightData;
		}
		interface def 'Vertiport to operations center data' {
			doc /* Information interface IF-014. Medium: ground network (PHY-006). Constraint: none recorded yet: boarding timestamps feed the monthly wait measure. Protection: authenticate the vertiport systems; encrypt passenger data in transit. Degraded mode: Timestamps missing: the wait measure has gaps for that period; dispatch is unaffected. */
			end port vertiports : 'Vertiport to operations center data port';
			end port operationsCenter : ~'Vertiport to operations center data port';
			flow vertiports.passengerInformation to operationsCenter.passengerInformation;
		}
		interface def 'Fire detection to operations center incident records' {
			doc /* Information interface IF-015. Medium: ground network (PHY-006). Constraint: each pad incident record in the evidence log within 1 h of the incident. Protection: one way only: the evidence log can never command the alarm system (domain separation); tamper-evident records: integrity-checked and kept unaltered for the insurers' audit. Degraded mode: Link down: the alarm system stores its records and forwards them when the link returns; the alarm path IF-007 is unaffected. */
			end port padFireDetectionAndAlarmSystem : 'Fire detection to operations center incident records port';
			end port operationsCenter : ~'Fire detection to operations center incident records port';
			flow padFireDetectionAndAlarmSystem.operationalEvidence to operationsCenter.operationalEvidence;
		}
		part physicalArchitecture {
			doc /* The physical architecture (Week 4 physical view, Week 5 components and interfaces): one part per physical element with its components, the ports of its interfaces and the functions it performs; the externals it exchanges with; the interfaces and connections. */
			ref part controlledAirspaceAirTrafficService :> Context::context.controlledAirspaceAirTrafficService {
				port toOperationsCenter : ~'Operations center to air traffic service port';
			}
			ref part electricGrid :> Context::context.electricGrid {
				port toChargingSystems : ~'Charger to electric grid port';
			}
			ref part emergencyResponseService :> Context::context.emergencyResponseService {
				port toPadFireDetectionAndAlarmSystem : ~'Fire alarm to emergency response service port';
			}
			ref part weatherInformationService :> Context::context.weatherInformationService {
				port toOperationsCenter : 'Weather information service to operations center port';
			}
			ref part aircraftAndSparesSupply :> Context::context.aircraftAndSparesSupply;
			part <'PHY-001'> eVTOLAircraft : 'eVTOL Aircraft' {
				attribute :>> padEdgeNoise = 63.5 [dB];
				part <'CMP-001'> airframeAndRotors : 'Airframe and rotors';
				part <'CMP-002'> batteryPackAndBatteryManagement : 'Battery pack and battery management';
				part <'CMP-003'> flightManagementAndHealthMonitoring : 'Flight management and health monitoring';
				port toVertiports : 'Aircraft to pad port';
				port toOperationsCenter : 'Aircraft to operations center datalink port';
				port toChargingSystems : 'Aircraft to charger power and handshake port';
				port toMaintenanceFacility : 'Aircraft to maintenance health data link port';
				perform Logical::'FN-005';
			}
			part <'PHY-002'> vertiports : 'Vertiports' {
				part <'CMP-004'> pads : 'Pads';
				part <'CMP-005'> terminalAndStepFreeRoute : 'Terminal and step-free route';
				part <'CMP-006'> vertiportStaff : 'Vertiport staff';
				port toEVTOLAircraft : ~'Aircraft to pad port';
				port toOperationsCenter : 'Vertiport to operations center data port';
				perform Logical::'FN-014';
			}
			part <'PHY-003'> chargingSystems : 'Charging Systems' {
				attribute :>> chargeTimeToDispatch = 18 [min];
				part <'CMP-007'> highPowerTurnaroundChargers : 'High-power turnaround chargers';
				part <'CMP-008'> standardChargers : 'Standard chargers';
				part <'CMP-009'> vertiportPowerController : 'Vertiport power controller';
				port toEVTOLAircraft : ~'Aircraft to charger power and handshake port';
				port toElectricGrid : 'Charger to electric grid port';
				port toOperationsCenter : 'Charger to operations center data port';
				perform Logical::'FN-006';
				perform Logical::'FN-007';
			}
			part <'PHY-004'> operationsCenter : 'Operations Center' {
				part <'CMP-010'> schedulingAndDispatchPlatform : 'Scheduling and dispatch platform';
				part <'CMP-011'> hotStandbyPlatform : 'Hot-standby platform';
				part <'CMP-012'> dutyManagersAndRemoteOperators : 'Duty managers and remote operators';
				part <'CMP-013'> planningAndEvidenceServices : 'Planning and evidence services';
				port toEVTOLAircraft : ~'Aircraft to operations center datalink port';
				port toControlledAirspaceAirTrafficService : 'Operations center to air traffic service port';
				port toPassengerBookingPlatform : ~'Booking platform to operations center port';
				port toChargingSystems : ~'Charger to operations center data port';
				port toWeatherInformationService : ~'Weather information service to operations center port';
				port toMaintenanceFacility : ~'Maintenance to operations center data port';
				port toVertiports : ~'Vertiport to operations center data port';
				port toPadFireDetectionAndAlarmSystem : ~'Fire detection to operations center incident records port';
				perform Logical::'FN-002';
				perform Logical::'FN-003';
				perform Logical::'FN-004';
				perform Logical::'FN-009';
				perform Logical::'FN-011';
				perform Logical::'FN-012';
				perform Logical::'FN-013';
				perform Logical::'FN-016';
				perform Logical::'FN-017';
			}
			part <'PHY-005'> maintenanceFacility : 'Maintenance Facility' {
				part <'CMP-014'> certifyingTechnicians : 'Certifying technicians';
				part <'CMP-015'> diagnosticToolsAndBatteryWorkshop : 'Diagnostic tools and battery workshop';
				port toOperationsCenter : 'Maintenance to operations center data port';
				port toEVTOLAircraft : ~'Aircraft to maintenance health data link port';
				perform Logical::'FN-008';
			}
			part <'PHY-006'> communicationsInfrastructure : 'Communications Infrastructure';
			part <'PHY-007'> passengerBookingPlatform : 'Passenger booking platform' {
				port toOperationsCenter : 'Booking platform to operations center port';
				perform Logical::'FN-001';
				perform Logical::'FN-015';
			}
			part <'PHY-008'> padFireDetectionAndAlarmSystem : 'Pad fire detection and alarm system' {
				port toEmergencyResponseService : 'Fire alarm to emergency response service port';
				port toOperationsCenter : 'Fire detection to operations center incident records port';
				perform Logical::'FN-010';
			}
			interface <'IF-001'> aircraftToPad : 'Aircraft to pad' connect eVTOLAircraft.toVertiports to vertiports.toEVTOLAircraft;
			interface <'IF-002'> aircraftToOperationsCenterDatalink : 'Aircraft to operations center datalink' connect eVTOLAircraft.toOperationsCenter to operationsCenter.toEVTOLAircraft;
			interface <'IF-003'> operationsCenterToAirTrafficService : 'Operations center to air traffic service' connect operationsCenter.toControlledAirspaceAirTrafficService to controlledAirspaceAirTrafficService.toOperationsCenter;
			connection <'IF-004'> operationsToMaintenanceWorkOrderHandover connect operationsCenter to maintenanceFacility {
				doc /* Organizational interface IF-004: Operations to maintenance work-order handover. Agreement: the agreed work-order procedure (a document). Constraint: an aircraft withdrawn by maintenance is returned only on a signed release to service. Nothing flows: it records an agreement between owners. */
			}
			interface <'IF-005'> aircraftToChargerPowerAndHandshake : 'Aircraft to charger power and handshake' connect eVTOLAircraft.toChargingSystems to chargingSystems.toEVTOLAircraft;
			interface <'IF-006'> chargerToElectricGrid : 'Charger to electric grid' connect chargingSystems.toElectricGrid to electricGrid.toChargingSystems;
			interface <'IF-007'> fireAlarmToEmergencyResponseService : 'Fire alarm to emergency response service' connect padFireDetectionAndAlarmSystem.toEmergencyResponseService to emergencyResponseService.toPadFireDetectionAndAlarmSystem;
			interface <'IF-008'> bookingPlatformToOperationsCenter : 'Booking platform to operations center' connect passengerBookingPlatform.toOperationsCenter to operationsCenter.toPassengerBookingPlatform;
			connection <'IF-009'> vertiportOperatorToAeroLinkPadSlotAgreement connect vertiports to operationsCenter {
				doc /* Organizational interface IF-009: Vertiport operator to AeroLink pad-slot agreement. Agreement: the pad-slot and ground-handling agreement (a contract). Constraint: none recorded yet: slot counts per hour are set in the agreement. Nothing flows: it records an agreement between owners. */
			}
			interface <'IF-010'> chargerToOperationsCenterData : 'Charger to operations center data' connect chargingSystems.toOperationsCenter to operationsCenter.toChargingSystems;
			interface <'IF-011'> weatherInformationServiceToOperationsCenter : 'Weather information service to operations center' connect weatherInformationService.toOperationsCenter to operationsCenter.toWeatherInformationService;
			interface <'IF-012'> maintenanceToOperationsCenterData : 'Maintenance to operations center data' connect maintenanceFacility.toOperationsCenter to operationsCenter.toMaintenanceFacility;
			interface <'IF-013'> aircraftToMaintenanceHealthDataLink : 'Aircraft to maintenance health data link' connect eVTOLAircraft.toMaintenanceFacility to maintenanceFacility.toEVTOLAircraft;
			interface <'IF-014'> vertiportToOperationsCenterData : 'Vertiport to operations center data' connect vertiports.toOperationsCenter to operationsCenter.toVertiports;
			interface <'IF-015'> fireDetectionToOperationsCenterIncidentRecords : 'Fire detection to operations center incident records' connect padFireDetectionAndAlarmSystem.toOperationsCenter to operationsCenter.toPadFireDetectionAndAlarmSystem;
			connection <'IF-016'> maintenanceToAircraftAndSparesSupply connect maintenanceFacility to aircraftAndSparesSupply {
				doc /* Organizational interface IF-016: Maintenance to aircraft and spares supply. Agreement: the aircraft purchase agreement's spares terms (a contract). Constraint: none recorded yet: spares lead time is set in the agreement. Nothing flows: it records an agreement between owners. */
			}
		}
		// The logical elements (Week 10) allocated to the physical elements that perform their functions, with a nested allocation for each function.
		allocate Logical::logicalArchitecture.flightOperations to physicalArchitecture.operationsCenter {
			allocate Logical::logicalArchitecture.flightOperations.'FN-003' to physicalArchitecture.operationsCenter.'FN-003';
			allocate Logical::logicalArchitecture.flightOperations.'FN-012' to physicalArchitecture.operationsCenter.'FN-012';
		}
		allocate Logical::logicalArchitecture.flightOperations to physicalArchitecture.eVTOLAircraft {
			allocate Logical::logicalArchitecture.flightOperations.'FN-005' to physicalArchitecture.eVTOLAircraft.'FN-005';
		}
		allocate Logical::logicalArchitecture.fleetManagement to physicalArchitecture.chargingSystems {
			allocate Logical::logicalArchitecture.fleetManagement.'FN-006' to physicalArchitecture.chargingSystems.'FN-006';
			allocate Logical::logicalArchitecture.fleetManagement.'FN-007' to physicalArchitecture.chargingSystems.'FN-007';
		}
		allocate Logical::logicalArchitecture.fleetManagement to physicalArchitecture.operationsCenter {
			allocate Logical::logicalArchitecture.fleetManagement.'FN-009' to physicalArchitecture.operationsCenter.'FN-009';
			allocate Logical::logicalArchitecture.fleetManagement.'FN-016' to physicalArchitecture.operationsCenter.'FN-016';
		}
		allocate Logical::logicalArchitecture.maintenanceManagement to physicalArchitecture.maintenanceFacility {
			allocate Logical::logicalArchitecture.maintenanceManagement.'FN-008' to physicalArchitecture.maintenanceFacility.'FN-008';
		}
