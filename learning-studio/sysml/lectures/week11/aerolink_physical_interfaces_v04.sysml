		allocate Requirements::'REQ-SYS-004' to 'FN-004';
		allocate Requirements::'REQ-SYS-002' to 'FN-005';
		allocate Requirements::'REQ-SYS-007' to 'FN-005';
		allocate Requirements::'REQ-SYS-001' to 'FN-006';
		allocate Requirements::'REQ-SYS-010' to 'FN-007';
		allocate Requirements::'REQ-SYS-008' to 'FN-008';
		allocate Requirements::'REQ-SYS-006' to 'FN-009';
		allocate Requirements::'REQ-SYS-009' to 'FN-010';
		allocate Requirements::'REQ-STK-006' to 'FN-011';
		allocate Requirements::'REQ-STK-009' to 'FN-012';
		allocate Requirements::'REQ-STK-007' to 'FN-014';
		allocate Requirements::'REQ-STK-018' to 'FN-015';
