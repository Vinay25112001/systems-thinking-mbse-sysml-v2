		part def 'System of interest' { doc /* The network's collection, warehousing and delivery service that moves donated food from donors to partner pantries. */ }
		part def 'System of interest (PRT-001)';
		part def 'PRT-003 (PRT-002)';
		part def 'Volunteer scheduling office';
		part def 'Donation intake desk';
		part soi : 'System of interest' {
			part <'PRT-001'> systemOfInterest : 'System of interest (PRT-001)';
			part <'PRT-002'> pRT003 : 'PRT-003 (PRT-002)';
