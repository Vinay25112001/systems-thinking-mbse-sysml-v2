		concern <'CON-001'> {
			doc /* Families arriving after work find the shelves empty of fresh produce by 5 p.m. */
			subject enterprise : 'O\'Neil "Quick" Relief \\ Network */ Co Model'::Context::'ENT-001';
			stakeholder familiesWhoSayItSLate : 'STK-001';
